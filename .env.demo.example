# Copie para .env.demo somente no servidor. Nunca versione .env.demo.
POSTGRES_DB=instrutorpro_demo
POSTGRES_USER=instrutorpro_demo
POSTGRES_PASSWORD=change-with-a-long-random-password
DATABASE_URL=postgis://instrutorpro_demo:change-with-a-long-random-password@db:5432/instrutorpro_demo
REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=change-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=SERVER_IP_OR_DOMAIN,localhost,backend
CORS_ALLOWED_ORIGINS=http://SERVER_IP_OR_DOMAIN
DJANGO_HTTPS_ENABLED=false
DJANGO_SECURE_HSTS_SECONDS=0

# Usuário admin sintético criado/atualizado pelo seed da demo.
DEMO_ADMIN_PASSWORD=change-with-a-long-random-demo-password
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
DEMO_HTTP_PORT=80
