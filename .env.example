DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-for-local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgis://instrutorpro:instrutorpro@db:5432/instrutorpro
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:4200
# MAPA ONLINE 01 não exige chave: Leaflet/OSM e geocoder DEMO_LOCAL.
# Nunca versione segredo de provider de produção.
DEMO_ADMIN_PASSWORD=change-me-for-local-demo-only
# Exceção somente para demonstração sintética; produção deve permanecer true.
DJANGO_ADMIN_MFA_REQUIRED=true
SYNTHETIC_MARKETPLACE_ENABLED=true
REAL_STUDENT_REGISTRATION_ENABLED=false
REAL_INSTRUCTOR_REGISTRATION_ENABLED=false
REAL_INSTRUCTOR_PUBLICATION_ENABLED=false
REAL_STUDENT_DEMAND_ENABLED=false
PUBLIC_DEMAND_MAP_ENABLED=false
# Limiar somente para demonstração sintética; não resolve OPEN-015.
DEMAND_MAP_MIN_AGGREGATION_COUNT=3
