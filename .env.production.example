# Copie para .env.production somente na VPS e substitua todos os placeholders.
# Nunca versione .env.production nem envie seus valores pelo chat.
POSTGRES_DB=instrutorpro_demo
POSTGRES_USER=instrutorpro_demo
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
DATABASE_URL=postgis://instrutorpro_demo:REPLACE_WITH_EXISTING_DATABASE_PASSWORD@db:5432/instrutorpro_demo
REDIS_URL=redis://redis:6379/0

APP_ENV=PRODUCTION
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=instrutorprocnh.com.br,www.instrutorprocnh.com.br,localhost,backend
CORS_ALLOWED_ORIGINS=https://instrutorprocnh.com.br
# A configuracao atual deriva CSRF_TRUSTED_ORIGINS de CORS_ALLOWED_ORIGINS.
DJANGO_HTTPS_ENABLED=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_ADMIN_MFA_REQUIRED=true
DJANGO_AXES_ENABLED=true
DJANGO_ADMIN_SESSION_AGE=1800

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
DJANGO_LOAD_DEMO_DATA=false
SYNTHETIC_MARKETPLACE_ENABLED=false
SYNTHETIC_DOCUMENT_UPLOAD_ENABLED=false
REAL_STUDENT_REGISTRATION_ENABLED=false
REAL_INSTRUCTOR_REGISTRATION_ENABLED=false
REAL_INSTRUCTOR_PUBLICATION_ENABLED=false
REAL_STUDENT_DEMAND_ENABLED=false
REAL_DOCUMENT_UPLOAD_ENABLED=false
PUBLIC_DEMAND_MAP_ENABLED=false
DEMAND_MAP_MIN_AGGREGATION_COUNT=0
# Marcador operacional: nao concede capacidade dentro da aplicacao.
REAL_PRODUCTION_AUTHORIZATION=NOT_GRANTED
REAL_ACCOUNT_REGISTRATION=false
REAL_PERSONAL_DATA=false
REAL_STUDENT_USE=false
REAL_INSTRUCTOR_REGISTRATION=false
REAL_MARKETPLACE_SEARCH=false
REAL_WHATSAPP_CONTACT=false
REAL_MARKETPLACE_ANALYTICS=false
# Estas capacidades nao podem ser habilitadas no piloto controlado.
REAL_DOCUMENT_UPLOADS=false
REAL_AUTOMATIC_PUBLICATION=false
REAL_PAYMENTS=false
REAL_PRO_BILLING=false

# Use uma chave restrita de produção. Insira-a diretamente na VPS, nunca no Git/chat.
MAPTILER_API_KEY=REPLACE_WITH_PRODUCTION_MAPTILER_KEY
MAPTILER_GEOCODING_URL=https://api.maptiler.com/geocoding
MAPTILER_MAP_URL=https://api.maptiler.com/maps/streets-v4
GEOCODING_TIMEOUT_SECONDS=4
INSTRUCTOR_SEARCH_MAX_RESULTS=50
PRIVATE_DOCUMENT_ROOT=/app/private_documents
